# Copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (starts with sb_publishable_…, or the legacy "anon" key). Safe in the browser.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts with sb_secret_…, or the legacy "service_role" key). SERVER ONLY.
SUPABASE_SECRET_KEY=

# Web Push keys: run `npx web-push generate-vapid-keys`
# (if left blank locally, dev keys are generated into data/vapid.json)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

PORT=3000
